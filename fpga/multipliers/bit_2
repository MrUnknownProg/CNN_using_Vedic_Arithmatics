module vedic_2x2 (
    input  [1:0] a,
    input  [1:0] b,
    output [3:0] p
);
    wire p0, p1, p2, p3;

    assign p0 = a[0] & b[0];
    assign p1 = (a[1] & b[0]) ^ (a[0] & b[1]);
    assign p2 = (a[1] & b[1]) ^ ((a[1] & b[0]) & (a[0] & b[1]));
    assign p3 = (a[1] & b[1]) & ((a[1] & b[0]) & (a[0] & b[1]));

    assign p = {p3, p2, p1, p0};
endmodule

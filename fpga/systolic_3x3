module systolic_3x3 (
    input              clk,
    input              en,

    input  [7:0]       pixel_in0,
    input  [7:0]       pixel_in1,
    input  [7:0]       pixel_in2,

    input  [7:0]       weight_in0,
    input  [7:0]       weight_in1,
    input  [7:0]       weight_in2,

    output [19:0]      out0,
    output [19:0]      out1,
    output [19:0]      out2,
    output [19:0]      out3,
    output [19:0]      out4,
    output [19:0]      out5,
    output [19:0]      out6,
    output [19:0]      out7,
    output [19:0]      out8
);

    // Pixel wires (horizontal)
    wire [7:0] p00, p01, p02;
    wire [7:0] p10, p11, p12;
    wire [7:0] p20, p21, p22;

    // Weight wires (vertical)
    wire [7:0] w00, w01, w02;
    wire [7:0] w10, w11, w12;
    wire [7:0] w20, w21, w22;

    // Accumulator wires (vertical flow)
    wire [19:0] a00, a10, a20;
    wire [19:0] a01, a11, a21;
    wire [19:0] a02, a12, a22;

    assign a00 = 0;
    assign a01 = 0;
    assign a02 = 0;

    /* ROW 0 */
    mac_vedic m00 (clk, en, pixel_in0, p00, weight_in0, w00, a00, a10);
    mac_vedic m01 (clk, en, p00,       p01, weight_in1, w01, a01, a11);
    mac_vedic m02 (clk, en, p01,       p02, weight_in2, w02, a02, a12);

    /* ROW 1 */
    mac_vedic m10 (clk, en, pixel_in1, p10, w00, w10, a10, a20);
    mac_vedic m11 (clk, en, p10,       p11, w01, w11, a11, a21);
    mac_vedic m12 (clk, en, p11,       p12, w02, w12, a12, a22);

    /* ROW 2 */
    mac_vedic m20 (clk, en, pixel_in2, p20, w10, w20, a20, out6);
    mac_vedic m21 (clk, en, p20,       p21, w11, w21, a21, out7);
    mac_vedic m22 (clk, en, p21,       p22, w12, w22, a22, out8);

    assign out0 = a10;
    assign out1 = a11;
    assign out2 = a12;

    assign out3 = a20;
    assign out4 = a21;
    assign out5 = a22;

endmodule

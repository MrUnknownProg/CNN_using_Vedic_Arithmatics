`timescale 1ns/1ps

module tb_conv_debug;

    reg clk;
    reg rst;
    reg en;

    reg [12:0] rd_addr;
    reg rd_en;

    wire signed [19:0] rd_data;
    wire done;

    integer conv_count;
    integer pool_count;

    integer conv_file;
    integer pool_file;

    integer conv_idx;
    integer pool_idx;

    reg first_seen;
    reg conv_valid_d;
    reg done_d;

    top_3x3 dut (
        .clk(clk),
        .rst(rst),
        .en(en),
        .rd_addr(rd_addr),
        .rd_en(rd_en),
        .rd_data(rd_data),
        .done(done)
    );
    
    always #5 clk = ~clk;

    initial begin
        clk = 0;
        rst = 1;
        en  = 0;

        rd_addr = 0;
        rd_en   = 0;

        conv_count = 0;
        pool_count = 0;

        conv_idx = 0;
        pool_idx = 0;

        first_seen   = 0;
        conv_valid_d = 0;
        done_d = 0;

        conv_file = $fopen("conv_output.txt","w");
        pool_file = $fopen("pool_output.txt","w");

        if(conv_file == 0) begin
            $display("ERROR: Cannot open conv_output.txt");
            $finish;
        end

        if(pool_file == 0) begin
            $display("ERROR: Cannot open pool_output.txt");
            $finish;
        end

        $readmemb("image9.mem",  dut.img_bram);
        $readmemb("weights.mem", dut.weight_bram);

        #20;
        rst = 0;

        #50;
        @(posedge clk);
        en = 1;
        @(posedge clk);
        en = 0;
    end
    
    initial begin
        #1;
        $display("\n========================================");
        $display("KERNEL WEIGHTS");
        $display("========================================");
        $display("%4d %4d %4d", dut.weight_bram[0], dut.weight_bram[1], dut.weight_bram[2]);
        $display("%4d %4d %4d", dut.weight_bram[3], dut.weight_bram[4], dut.weight_bram[5]);
        $display("%4d %4d %4d", dut.weight_bram[6], dut.weight_bram[7], dut.weight_bram[8]);
        $display("========================================\n");
        $display("\nWeights into Systolic:");
        $display("%4d %4d %4d", dut.sa.weight_in0,dut.sa.weight_in1,dut.sa.weight_in2);
        $display("%4d %4d %4d", dut.sa.weight_in3,dut.sa.weight_in4,dut.sa.weight_in5);
        $display("%4d %4d %4d", dut.sa.weight_in6,dut.sa.weight_in7,dut.sa.weight_in8);
    end

    always @(posedge clk) begin
        if(!rst && dut.conv_valid && !first_seen) begin
            first_seen <= 1;
            $display("");
            $display("================================");
            $display("FIRST CONV_VALID");
            $display("TIME        = %0t", $time);
            $display("CONV_SUM    = %0d", dut.conv_sum);
            $display("================================");
            $display("");
        end
    end

    always @(posedge clk) begin
        conv_valid_d <= dut.conv_valid;
        done_d       <= done;

        if(!rst) begin
            if(!conv_valid_d && dut.conv_valid)
                $display("CONV_VALID RISE @ %0t", $time);         

            if(conv_valid_d && !dut.conv_valid)
                $display("CONV_VALID FALL @ %0t", $time);

            if(!done_d && done) begin
                $display("");
                $display("================================");
                $display("DONE ASSERTED");
                $display("TIME         = %0t", $time);
                $display("CONV OUTPUTS = %0d", conv_count);
                $display("POOL OUTPUTS = %0d", pool_count);
                $display("================================");
                $display("");
            end
        end
    end
    
    integer conv_valid_count;
    integer actual_conv_count;
    reg signed [19:0] prev_conv_sum;

    always @(posedge clk) begin
        if(rst) begin
            conv_valid_count <= 0;
            actual_conv_count <= 0;
            prev_conv_sum <= 0;
        end
        else begin
            if(dut.conv_valid)
                conv_valid_count <= conv_valid_count + 1;

            if(dut.conv_valid && (dut.conv_sum !== prev_conv_sum))
                actual_conv_count <= actual_conv_count + 1;

            prev_conv_sum <= dut.conv_sum;
        end
    end

    wire [31:0] conv_valid_count_dbg;
    wire [31:0] actual_conv_count_dbg;
    wire conv_valid = dut.conv_valid;
    wire raw_conv_valid = dut.raw_conv_valid;
    
    integer dbg_file;

    initial begin
        dbg_file = $fopen("conv_debug.txt","w");
    end
        
    integer dbg_row;
    integer dbg_col;
    
    wire signed window_valid = dut.window_valid;   

    wire signed [7:0] pixel_in0 = dut.sa.pixel_in0;
    wire signed [7:0] pixel_in1 = dut.sa.pixel_in1;
    wire signed [7:0] pixel_in2 = dut.sa.pixel_in2;

    wire signed [19:0] o6_dbg = dut.o6;
    wire signed [19:0] o7_dbg = dut.o7;
    wire signed [19:0] o8_dbg = dut.o8;
    
    wire signed [19:0] conv_sum_dbg = dut.conv_sum;
    wire signed [19:0] relu_out_dbg = dut.relu_out;
    
    wire signed [19:0] data_out = dut.pool_inst.data_out;
    
    always @(posedge clk) begin
        if(!rst && dut.conv_valid) begin
            dbg_row = conv_idx / 26;
            dbg_col = conv_idx % 26;
    
            $fdisplay(
                dbg_file,
                "%0d | %0d %0d | %0d %0d %0d | %0d %0d %0d %0d %0d %0d %0d %0d %0d | %0d | %0d",
                conv_idx,
                dbg_row,
                dbg_col,
                $signed(dut.row0),
                $signed(dut.row1),
                $signed(dut.row2),
                $signed(dut.o0),
                $signed(dut.o1),
                $signed(dut.o2),
                $signed(dut.o3),
                $signed(dut.o4),
                $signed(dut.o5),
                $signed(dut.o6),
                $signed(dut.o7),
                $signed(dut.o8),
                $signed(dut.conv_sum),
                dut.relu_out
            );
        end
    end
 
    always @(posedge clk) begin
        if(!rst && dut.conv_valid) begin
            conv_count <= conv_count + 1;
            $fdisplay(
                conv_file,
                "%0d : %0d",
                conv_idx,
                $signed(dut.relu_out)
            );
            conv_idx <= conv_idx + 1;
        end
    end

    always @(posedge clk) begin
        if(!rst && dut.pool_valid) begin
            pool_count <= pool_count + 1;
            $fdisplay(
                pool_file,
                "%0d : %0d",
                pool_idx,
                $signed(dut.pool_inst.data_out)
            );
            pool_idx <= pool_idx + 1;
        end
    end

    initial begin
        wait(done);
        #20;
        $display("");
        $display("================================");
        $display("DONE ASSERTED");
        $display("TIME         = %0t", $time);
        $display("CONV OUTPUTS = %0d", conv_count);
        $display("POOL OUTPUTS = %0d", pool_count);
        $display("================================");
        $display("");
        $fclose(conv_file);
        $fclose(pool_file);
        $finish;
    end

    initial begin
        #10000000;
        $display("");
        $display("TIMEOUT");
        $display("CONV OUTPUTS = %0d", conv_count);
        $display("POOL OUTPUTS = %0d", pool_count);
        if(conv_file != 0) $fclose(conv_file);
        if(pool_file != 0) $fclose(pool_file);
        $finish;
    end

endmodule

`timescale 1ns/1ps

module tb_conv_debug;

    parameter IMG_W = 28;

    reg clk;
    reg rst;
    reg en;

    reg [12:0] rd_addr;
    reg rd_en;

    wire signed [19:0] rd_data;
    wire done;

    integer i;

    top_3x3 dut (
        .clk(clk),
        .rst(rst),
        .en(en),
        .rd_addr(rd_addr),
        .rd_en(rd_en),
        .rd_data(rd_data),
        .done(done)
    );

    // ============================================================
    // CLOCK
    // ============================================================
    always #5 clk = ~clk;

    // ============================================================
    // INITIALIZATION
    // ============================================================
    initial begin

        clk     = 0;
        rst     = 1;
        en      = 0;
        rd_addr = 0;
        rd_en   = 0;

        // Clear image BRAM
        for(i=0; i<784; i=i+1)
            dut.img_bram[i] = 0;

        // Single impulse at center
        //dut.img_bram[(14*28)+14] = 8'd127;
        dut.img_bram[(14*28)+14] = 1;
        dut.img_bram[(14*28)+15] = 2;
        dut.img_bram[(14*28)+16] = 3;
        
        dut.img_bram[(15*28)+14] = 4;
        dut.img_bram[(15*28)+15] = 5;
        dut.img_bram[(15*28)+16] = 6;
        
        dut.img_bram[(16*28)+14] = 7;
        dut.img_bram[(16*28)+15] = 8;
        dut.img_bram[(16*28)+16] = 9;

        // 3x3 kernel
        dut.weight_bram[0] = 8'd1;
        dut.weight_bram[1] = 8'd2;
        dut.weight_bram[2] = 8'd3;

        dut.weight_bram[3] = 8'd4;
        dut.weight_bram[4] = 8'd5;
        dut.weight_bram[5] = 8'd6;

        dut.weight_bram[6] = 8'd7;
        dut.weight_bram[7] = 8'd8;
        dut.weight_bram[8] = 8'd9;

        #20;
        rst = 0;

        #50;
        en = 1;

    end

    // ============================================================
    // DEBUG
    // ============================================================
   integer max_sum;

    initial
        max_sum = 0;
    
    always @(posedge clk) begin
        if (dut.conv_sum > max_sum)
            max_sum <= dut.o6 + dut.o7 + dut.o8;
    end
   
   always @(posedge clk) begin
    if(dut.pixel_count >= 460 &&
       dut.pixel_count <= 500) begin
        
        $display("SUM=%0d", dut.o6 + dut.o7 + dut.o8);
        $display(
        "PC=%0d | W=[%0d %0d %0d | %0d %0d %0d | %0d %0d %0d] | O=[%0d %0d %0d | %0d %0d %0d | %0d %0d %0d]",
        dut.pixel_count,

        dut.w00,dut.w01,dut.w02,
        dut.w10,dut.w11,dut.w12,
        dut.w20,dut.w21,dut.w22,

        dut.o0,dut.o1,dut.o2,
        dut.o3,dut.o4,dut.o5,
        dut.o6,dut.o7,dut.o8
        );

    end
end

    // ============================================================
    // STOP CONDITION
    // ============================================================
    initial begin

        wait(dut.pixel_count > 500);

        $display("\n");
        $display("########################################################");
        $display("DEBUG COMPLETE");
        $display("########################################################");

        $display("Final Outputs:");
        $display("O6 = %0d", dut.o6);
        $display("O7 = %0d", dut.o7);
        $display("O8 = %0d", dut.o8);
        $display("MAX O8 = %0d", max_sum);

        $display("SUM = %0d",
                 dut.o6 +
                 dut.o7 +
                 dut.o8);

        $finish;

    end

    // ============================================================
    // TIMEOUT PROTECTION
    // ============================================================
    initial begin

        #50000;

        $display("\nTIMEOUT OCCURRED");
        $finish;

    end

endmodule

`timescale 1ns/1ps

module tb_conv_debug;

    reg clk;
    reg rst;
    reg en;

    reg [12:0] rd_addr;
    reg rd_en;

    wire signed [19:0] rd_data;
    wire done;

    integer conv_count;
    integer pool_count;

    integer conv_file;
    integer pool_file;

    integer conv_idx;
    integer pool_idx;

    reg first_seen;
    reg conv_valid_d;
    reg done_d;

    top_3x3 dut (
        .clk(clk),
        .rst(rst),
        .en(en),
        .rd_addr(rd_addr),
        .rd_en(rd_en),
        .rd_data(rd_data),
        .done(done)
    );

    //====================================================
    // CLOCK
    //====================================================
    always #5 clk = ~clk;

    //====================================================
    // INIT
    //====================================================
    initial begin

        clk = 0;
        rst = 1;
        en  = 0;

        rd_addr = 0;
        rd_en   = 0;

        conv_count = 0;
        pool_count = 0;

        conv_idx = 0;
        pool_idx = 0;

        first_seen  = 0;
        conv_valid_d = 0;
        done_d = 0;

        conv_file = $fopen("conv_output.txt","w");
        pool_file = $fopen("pool_output.txt","w");

        if(conv_file == 0) begin
            $display("ERROR: Cannot open conv_output.txt");
            $finish;
        end

        if(pool_file == 0) begin
            $display("ERROR: Cannot open pool_output.txt");
            $finish;
        end

        $readmemb("image.mem",   dut.img_bram);
        $readmemb("weights.mem", dut.weight_bram);

        #20;
        rst = 0;

        #50;
        en = 1;

    end

    //====================================================
    // FIRST CONV VALID
    //====================================================
    always @(posedge clk) begin

        if(!rst && dut.conv_valid && !first_seen) begin

            first_seen <= 1;

            $display("");
            $display("================================");
            $display("FIRST CONV_VALID");
            $display("TIME        = %0t", $time);
            $display("PIXEL_COUNT = %0d", dut.pixel_count);
            $display("CONV_SUM    = %0d", dut.conv_sum);
            $display("================================");
            $display("");

        end

    end

    //====================================================
    // EDGE DETECTORS
    //====================================================
    always @(posedge clk) begin

        conv_valid_d <= dut.conv_valid;
        done_d       <= done;

        if(!rst) begin

            if(!conv_valid_d && dut.conv_valid)
                $display("CONV_VALID RISE @ %0t  PC=%0d",
                         $time,dut.pixel_count);

            if(conv_valid_d && !dut.conv_valid)
                $display("CONV_VALID FALL @ %0t  PC=%0d",
                         $time,dut.pixel_count);

            if(!done_d && done) begin

                $display("");
                $display("================================");
                $display("DONE ASSERTED");
                $display("TIME         = %0t", $time);
                $display("CONV OUTPUTS = %0d", conv_count);
                $display("POOL OUTPUTS = %0d", pool_count);
                $display("================================");
                $display("");

            end

        end

    end

    //====================================================
    // SAVE CONV OUTPUTS
    //====================================================
    always @(posedge clk) begin

        if(!rst && dut.conv_valid) begin

            conv_count <= conv_count + 1;

            $fdisplay(
                conv_file,
                "%0d : %0d",
                conv_idx,
                $signed(dut.relu_out)
            );

            conv_idx <= conv_idx + 1;

        end

    end

    //====================================================
    // SAVE POOL OUTPUTS
    //====================================================
    always @(posedge clk) begin

        if(!rst && dut.pool_valid) begin

            pool_count <= pool_count + 1;

            $fdisplay(
                pool_file,
                "%0d : %0d",
                pool_idx,
                $signed(dut.pool_out)
            );

            pool_idx <= pool_idx + 1;

        end

    end



    //====================================================
    // STOP AFTER EXPECTED CONV OUTPUTS
    //====================================================
    initial begin

        wait(conv_count == 676);
        #20;

        $display("");
        $display("================================");
        $display("EXPECTED OUTPUT COUNT REACHED");
        $display("TIME         = %0t", $time);
        $display("CONV OUTPUTS = %0d", conv_count);
        $display("POOL OUTPUTS = %0d", pool_count);
        $display("DONE         = %b", done);
        $display("Conv_cnt = %0d", dut.conv_cnt);
        $display("================================");
        $display("");

        $fclose(conv_file);
        $fclose(pool_file);

        $finish;

    end



    //====================================================
    // TIMEOUT
    //====================================================
    initial begin

        #10000000;

        $display("");
        $display("TIMEOUT");
        $display("CONV OUTPUTS = %0d", conv_count);
        $display("POOL OUTPUTS = %0d", pool_count);

        if(conv_file != 0)
            $fclose(conv_file);

        if(pool_file != 0)
            $fclose(pool_file);

        $finish;

    end

endmodule

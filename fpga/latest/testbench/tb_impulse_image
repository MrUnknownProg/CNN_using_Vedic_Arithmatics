`timescale 1ns/1ps

module tb_conv_debug;

    parameter IMG_W = 28;

    reg clk;
    reg rst;
    reg en;

    reg [12:0] rd_addr;
    reg rd_en;

    wire signed [19:0] rd_data;
    wire done;

    integer i;

    top_3x3 dut (
        .clk(clk),
        .rst(rst),
        .en(en),
        .rd_addr(rd_addr),
        .rd_en(rd_en),
        .rd_data(rd_data),
        .done(done)
    );

    // ================= CLOCK =================
    always #5 clk = ~clk;

    // ================= INIT =================
    initial begin

        clk     = 0;
        rst     = 1;
        en      = 0;
        rd_addr = 0;
        rd_en   = 0;

        // Clear image
        for(i=0;i<784;i=i+1)
            dut.img_bram[i] = 0;

        // Impulse
        dut.img_bram[(14*28)+14] = 8'd127;

        // Kernel
        dut.weight_bram[0] = 8'd1;
        dut.weight_bram[1] = 8'd2;
        dut.weight_bram[2] = 8'd3;

        dut.weight_bram[3] = 8'd4;
        dut.weight_bram[4] = 8'd5;
        dut.weight_bram[5] = 8'd6;

        dut.weight_bram[6] = 8'd7;
        dut.weight_bram[7] = 8'd8;
        dut.weight_bram[8] = 8'd9;

        #20;
        rst = 0;

        #50;
        en = 1;

    end

    // ================= DEBUG =================
    always @(posedge clk) begin

        if(dut.pixel_count >= 390 &&
           dut.pixel_count <= 430) begin

            $display(
            "PC=%0d | R0=%4d R1=%4d R2=%4d | O0=%5d O1=%5d O2=%5d | O3=%5d O4=%5d O5=%5d | O6=%5d O7=%5d O8=%5d | SUM=%5d",
            dut.pixel_count,

            dut.row0,
            dut.row1,
            dut.row2,

            dut.o0,
            dut.o1,
            dut.o2,

            dut.o3,
            dut.o4,
            dut.o5,

            dut.o6,
            dut.o7,
            dut.o8,

            dut.o6 + dut.o7 + dut.o8
            );

        end

    end
    
    always @(posedge clk) begin

    if(dut.pixel_count >= 405 &&
       dut.pixel_count <= 415) begin
        $display(
        "PC=%0d | W0=%0d W1=%0d W2=%0d | W3=%0d W4=%0d W5=%0d | W6=%0d W7=%0d W8=%0d",
        dut.pixel_count,

        dut.k0,
        dut.k1,
        dut.k2,

        dut.k3,
        dut.k4,
        dut.k5,

        dut.k6,
        dut.k7,
        dut.k8
        );

    end

end

always @(posedge clk) begin

if(dut.pixel_count >= 400 &&
   dut.pixel_count <= 420) begin

    $display(
    "PC=%0d | \n %3d %3d %3d | \n %3d %3d %3d | \n %3d %3d %3d",

    dut.pixel_count,

    dut.w00,dut.w01,dut.w02,
    dut.w10,dut.w11,dut.w12,
    dut.w20,dut.w21,dut.w22
    );

end

end

    // ================= STOP =================
    initial begin

        wait(dut.pixel_count > 430);

        $display("\n===== DEBUG COMPLETE =====");

        $display("Final:");
        $display("O6=%0d", dut.o6);
        $display("O7=%0d", dut.o7);
        $display("O8=%0d", dut.o8);

        $display("SUM=%0d",
                 dut.o6 +
                 dut.o7 +
                 dut.o8);

        $finish;

    end

    // ================= SAFETY =================
    initial begin
        #50000;
        $display("TIMEOUT");
        $finish;
    end

endmodule

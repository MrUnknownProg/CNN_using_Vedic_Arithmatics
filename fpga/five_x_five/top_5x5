module conv5x5_bram_top #(
    parameter IMG_W = 28,
    parameter OUT_W = 24            // 28 - 5 + 1
)(
    input              clk,
    input              en,

    input      [7:0]   pixel_in,

    input      [7:0]   w0,
    input      [7:0]   w1,
    input      [7:0]   w2,
    input      [7:0]   w3,
    input      [7:0]   w4,

    input      [13:0]  rd_addr,
    input              rd_en,
    output reg [23:0]  rd_data
);

    localparam TOTAL_WINDOWS = OUT_W * OUT_W;

    // 25 outputs per window
    reg [23:0] fmap_bram [0:TOTAL_WINDOWS*25-1];

    /* ===== Line buffer & sliding window ===== */

    wire [7:0] row0,row1,row2,row3,row4;
    wire [199:0] win_flat;   // 25 * 8 bits

    line_buffer_5 #(.IMG_W(IMG_W)) lb (
        .clk(clk),
        .en(en),
        .pixel_in(pixel_in),
        .row0(row0),
        .row1(row1),
        .row2(row2),
        .row3(row3),
        .row4(row4)
    );

    sliding_window_5x5 sw (
        .clk(clk),
        .en(en),
        .row0(row0),
        .row1(row1),
        .row2(row2),
        .row3(row3),
        .row4(row4),
        .win_flat(win_flat)
    );

    /* ===== Extract last column pixels ===== */
    wire [7:0] p0 = win_flat[20*8 +: 8];
    wire [7:0] p1 = win_flat[21*8 +: 8];
    wire [7:0] p2 = win_flat[22*8 +: 8];
    wire [7:0] p3 = win_flat[23*8 +: 8];
    wire [7:0] p4 = win_flat[24*8 +: 8];

    wire [23:0] o [0:24];

    systolic_5x5 sa (
        .clk(clk),
        .en(en),
        .pixel_in0(p0),
        .pixel_in1(p1),
        .pixel_in2(p2),
        .pixel_in3(p3),
        .pixel_in4(p4),
        .weight_in0(w0),
        .weight_in1(w1),
        .weight_in2(w2),
        .weight_in3(w3),
        .weight_in4(w4),
        .out0(o[0]),  .out1(o[1]),  .out2(o[2]),  .out3(o[3]),  .out4(o[4]),
        .out5(o[5]),  .out6(o[6]),  .out7(o[7]),  .out8(o[8]),  .out9(o[9]),
        .out10(o[10]),.out11(o[11]),.out12(o[12]),.out13(o[13]),.out14(o[14]),
        .out15(o[15]),.out16(o[16]),.out17(o[17]),.out18(o[18]),.out19(o[19]),
        .out20(o[20]),.out21(o[21]),.out22(o[22]),.out23(o[23]),.out24(o[24])
    );

    /* ===== BRAM write control ===== */

    integer win_idx = 0;
    reg [4:0] write_sel;
    reg [13:0] wr_addr;

    always @(posedge clk) begin
        if (en) begin
            wr_addr <= win_idx*25 + write_sel;
            fmap_bram[wr_addr] <= o[write_sel];

            if (write_sel == 24) begin
                write_sel <= 0;
                win_idx   <= win_idx + 1;
            end else begin
                write_sel <= write_sel + 1;
            end
        end
    end

    /* ===== BRAM read ===== */

    always @(posedge clk) begin
        if (rd_en)
            rd_data <= fmap_bram[rd_addr];
    end

endmodule


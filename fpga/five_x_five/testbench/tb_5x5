module tb_conv5x5;

    /* ------------------------------------------------------------
     * Parameters
     * ------------------------------------------------------------ */
    localparam IMG_W = 5;
    localparam OUT_W = 1;

    /* ------------------------------------------------------------
     * DUT signals
     * ------------------------------------------------------------ */
    reg clk;
    reg en;

    reg  [7:0] pixel_in;

    reg  [7:0] w0, w1, w2, w3, w4;

    reg  [13:0] rd_addr;
    reg         rd_en;
    wire [23:0] rd_data;

    /* ------------------------------------------------------------
     * Clock generation (100 MHz)
     * ------------------------------------------------------------ */
    always #5 clk = ~clk;

    /* ------------------------------------------------------------
     * DUT instantiation
     * ------------------------------------------------------------ */
    conv5x5_bram_top #(
        .IMG_W(IMG_W),
        .OUT_W(OUT_W)
    ) dut (
        .clk(clk),
        .en(en),
        .pixel_in(pixel_in),

        .w0(w0), .w1(w1), .w2(w2), .w3(w3), .w4(w4),

        .rd_addr(rd_addr),
        .rd_en(rd_en),
        .rd_data(rd_data)
    );

    /* ------------------------------------------------------------
     * Test data
     * ------------------------------------------------------------ */
    reg [7:0] image   [0:24];
    reg [7:0] weights [0:24];

    integer i;
    integer golden_sum;
    integer errors;

    /* ------------------------------------------------------------
     * Pipeline latency calculation
     *
     * Line buffer   : IMG_W * (K-1) = 5 * 4 = 20
     * Sliding window: K             = 5
     * Systolic MAC  : K             = 5
     * -------------------------------------
     * TOTAL         = 30 cycles
     * ------------------------------------------------------------ */
    localparam PIPELINE_LATENCY = 30;

    /* ------------------------------------------------------------
     * Test sequence
     * ------------------------------------------------------------ */
    initial begin
        clk = 0;
        en  = 0;
        pixel_in = 0;
        rd_addr  = 0;
        rd_en    = 0;
        errors   = 0;

        /* Initialize image: 1..25 */
        for (i = 0; i < 25; i = i + 1)
            image[i] = i + 1;

        /* Initialize weights: all 1 */
        for (i = 0; i < 25; i = i + 1)
            weights[i] = 8'd1;

        /* Apply first row of weights */
        w0 = weights[0];
        w1 = weights[1];
        w2 = weights[2];
        w3 = weights[3];
        w4 = weights[4];

        /* Start streaming */
        #20;
        en = 1;

        /* Feed pixels (raster scan) */
        for (i = 0; i < 25; i = i + 1) begin
            pixel_in = image[i];
            @(posedge clk);
        end

        /* Wait for full pipeline to flush */
        repeat (PIPELINE_LATENCY) @(posedge clk);

        /* --------------------------------------------------------
         * Golden convolution
         * -------------------------------------------------------- */
        golden_sum = 0;
        for (i = 0; i < 25; i = i + 1)
            golden_sum = golden_sum + image[i] * weights[i];

        /* --------------------------------------------------------
         * Check final accumulator
         * Bottom-right MAC = acc[4][4]
         * -------------------------------------------------------- */
        if (dut.sa.acc[4][4] !== golden_sum) begin
            $display("FAIL");
            $display("Expected = %0d", golden_sum);
            $display("Got      = %0d", dut.sa.acc[4][4]);
            errors = errors + 1;
        end else begin
            $display("PASS");
            $display("Convolution result = %0d", dut.sa.acc[4][4]);
        end

        if (errors == 0)
            $display("TEST PASSED");
        else
            $display("TEST FAILED with %0d error(s)", errors);

        $finish;
    end

endmodule

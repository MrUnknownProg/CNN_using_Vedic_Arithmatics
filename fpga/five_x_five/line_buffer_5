module line_buffer_5 #(
    parameter IMG_W = 28
)(
    input        clk,
    input        en,
    input  [7:0] pixel_in,
    output [7:0] row0,row1,row2,row3,row4
);

    reg [7:0] line0 [0:IMG_W-1];
    reg [7:0] line1 [0:IMG_W-1];
    reg [7:0] line2 [0:IMG_W-1];
    reg [7:0] line3 [0:IMG_W-1];
    reg [7:0] line4 [0:IMG_W-1];

    integer i;

    always @(posedge clk) begin
        if (en) begin
            for (i = IMG_W-1; i > 0; i = i-1) begin
                line0[i] <= line0[i-1];
                line1[i] <= line1[i-1];
                line2[i] <= line2[i-1];
                line3[i] <= line3[i-1];
                line4[i] <= line4[i-1];
            end
            line0[0] <= pixel_in;
            line1[0] <= line0[IMG_W-1];
            line2[0] <= line1[IMG_W-1];
            line3[0] <= line2[IMG_W-1];
            line4[0] <= line3[IMG_W-1];
        end
    end

    assign row0 = line0[0];
    assign row1 = line1[0];
    assign row2 = line2[0];
    assign row3 = line3[0];
    assign row4 = line4[0];

endmodule

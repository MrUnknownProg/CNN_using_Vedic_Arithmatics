module sliding_window_5x5 (
    input         clk,
    input         en,
    input  [7:0]  row0,row1,row2,row3,row4,
    output reg [199:0] win_flat
);

    integer i;

    always @(posedge clk) begin
        if (en) begin
            for (i = 0; i < 20; i = i+1)
                win_flat[i*8 +: 8] <= win_flat[(i+1)*8 +: 8];

            win_flat[20*8 +: 8] <= row0;
            win_flat[21*8 +: 8] <= row1;
            win_flat[22*8 +: 8] <= row2;
            win_flat[23*8 +: 8] <= row3;
            win_flat[24*8 +: 8] <= row4;
        end
    end

endmodule

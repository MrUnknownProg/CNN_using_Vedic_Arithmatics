module systolic_5x5 (
    input clk,
    input en,

    input [7:0] pixel_in0, pixel_in1, pixel_in2, pixel_in3, pixel_in4,
    input [7:0] weight_in0,weight_in1,weight_in2,weight_in3,weight_in4,

    output [19:0] out0,  output [19:0] out1,  output [19:0] out2,  output [19:0] out3,  output [19:0] out4,
    output [19:0] out5,  output [19:0] out6,  output [19:0] out7,  output [19:0] out8,  output [19:0] out9,
    output [19:0] out10, output [19:0] out11, output [19:0] out12, output [19:0] out13, output [19:0] out14,
    output [19:0] out15, output [19:0] out16, output [19:0] out17, output [19:0] out18, output [19:0] out19,
    output [19:0] out20, output [19:0] out21, output [19:0] out22, output [19:0] out23, output [19:0] out24
);

    /* ===== Systolic interconnect ===== */

    wire [7:0]  p   [0:4][0:5];   // pixels → right
    wire [7:0]  w   [0:5][0:4];   // weights ↓ down
    wire [19:0] acc [0:5][0:4];   // acc ↓ down

    /* ===== Input injection ===== */

    assign p[0][0] = pixel_in0;
    assign p[1][0] = pixel_in1;
    assign p[2][0] = pixel_in2;
    assign p[3][0] = pixel_in3;
    assign p[4][0] = pixel_in4;

    assign w[0][0] = weight_in0;
    assign w[0][1] = weight_in1;
    assign w[0][2] = weight_in2;
    assign w[0][3] = weight_in3;
    assign w[0][4] = weight_in4;

    genvar i,j;
    generate
        for (i = 0; i < 5; i = i+1) begin : ROW
            for (j = 0; j < 5; j = j+1) begin : COL

                mac_vedic mac (
                    .clk(clk),
                    .en(en),

                    .pixel_in (p[i][j]),
                    .pixel_out(p[i][j+1]),

                    .weight_in (w[i][j]),
                    .weight_out(w[i+1][j]),

                    .acc_in  (i == 0 ? 20'd0 : acc[i-1][j]),
                    .acc_out (acc[i][j])
                );

            end
        end
    endgenerate

    /* ===== Output taps (bottom row = final sums) ===== */

    assign out0  = acc[0][0];  assign out1  = acc[0][1];  assign out2  = acc[0][2];  assign out3  = acc[0][3];  assign out4  = acc[0][4];
    assign out5  = acc[1][0];  assign out6  = acc[1][1];  assign out7  = acc[1][2];  assign out8  = acc[1][3];  assign out9  = acc[1][4];
    assign out10 = acc[2][0];  assign out11 = acc[2][1];  assign out12 = acc[2][2];  assign out13 = acc[2][3];  assign out14 = acc[2][4];
    assign out15 = acc[3][0];  assign out16 = acc[3][1];  assign out17 = acc[3][2];  assign out18 = acc[3][3];  assign out19 = acc[3][4];
    assign out20 = acc[4][0];  assign out21 = acc[4][1];  assign out22 = acc[4][2];  assign out23 = acc[4][3];  assign out24 = acc[4][4];

endmodule

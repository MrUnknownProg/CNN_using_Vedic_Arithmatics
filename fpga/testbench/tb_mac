module tb_mac_vedic;
    reg clk,en;
    reg [7:0] pixel,weight;
    reg [19:0] acc_in;
    wire [19:0] acc_out;

    mac_vedic dut (clk,en,pixel,weight,acc_in,acc_out);

    always #5 clk = ~clk;

    initial begin
        clk=0; en=1;
        acc_in=0;

        pixel=10; weight=20; #10;
        if (acc_out !== 200)
            $fatal("MAC8 FAIL");

        acc_in=acc_out;
        pixel=5; weight=6; #10;
        if (acc_out !== 230)
            $fatal("MAC8 ACC FAIL");

        // Stress test
        repeat (20) begin
            acc_in = acc_out;
            pixel = $random;
            weight = $random;
            #10;
            if (acc_out !== acc_in + pixel*weight)
                $fatal("MAC8 RANDOM FAIL");
        end

        $display("mac_vedic_8bit PASS");
        $finish;
    end
endmodule


module mac_vedic (
    input            clk,
    input            en,

    input  [7:0]     pixel_in,
    output reg [7:0] pixel_out,

    input  [7:0]     weight_in,
    output reg [7:0] weight_out,

    input  [19:0]    acc_in,
    output reg [19:0] acc_out
);
    wire [15:0] prod;

    vedic_8x8 mul (
        .a(pixel_in),
        .b(weight_in),
        .p(prod)
    );

    always @(posedge clk) begin
        if (en)
            acc_out <= acc_in + prod;
        else
            acc_out <= acc_in;

        // Forward data systolically
        pixel_out  <= pixel_in;
        weight_out <= weight_in;
    end
endmodule




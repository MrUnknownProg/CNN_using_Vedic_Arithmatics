module mac_vedic (
    input            clk,
    input            en,
    input  [7:0]     pixel,
    input  [7:0]     weight,
    input  [19:0]    acc_in,
    output reg [19:0] acc_out
);
    wire [15:0] prod;

    vedic_8x8 mul (
        .a(pixel),
        .b(weight),
        .p(prod)
    );

    always @(posedge clk) begin
        if (en)
            acc_out <= acc_in + prod;
        else
            acc_out <= acc_in;
    end
endmodule

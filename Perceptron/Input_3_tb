module tb_perceptron_3input;

    reg clk;
    reg signed [7:0] x1, x2, x3;
    wire y;

    // Instantiate DUT
    perceptron_3input uut (
        .clk(clk),
        .x1(x1),
        .x2(x2),
        .x3(x3),
        .y(y)
    );

    // Clock generation
    always #5 clk = ~clk;

    // Task to apply inputs safely
    task apply_input;
        input signed [7:0] a, b, c;
        begin
            @(negedge clk);  // change inputs away from sampling edge
            x1 = a;
            x2 = b;
            x3 = c;
            @(posedge clk);  // wait for computation
            #1;              // small delay to settle
            $display("x1=%0d x2=%0d x3=%0d -> y=%b", x1, x2, x3, y);
        end
    endtask

    initial begin
        clk = 0;
        x1 = 0; x2 = 0; x3 = 0;

        $display("\n--- Perceptron Test ---");

        apply_input(0,0,0); // expect 0
        apply_input(1,0,0); // expect 0
        apply_input(1,1,0); // expect 1
        apply_input(1,1,1); // expect 1

        $display("--- Test Complete ---\n");
        $finish;
    end

endmodule

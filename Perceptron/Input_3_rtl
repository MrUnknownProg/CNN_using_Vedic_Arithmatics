module perceptron_3input #
(
    parameter WIDTH = 8
)
(
    input  wire                     clk,
    input  wire signed [WIDTH-1:0] x1,
    input  wire signed [WIDTH-1:0] x2,
    input  wire signed [WIDTH-1:0] x3,
    output reg signed [15:0] y
    //output reg                      y
);

    localparam signed [WIDTH-1:0] W1 = 8'sd2;
    localparam signed [WIDTH-1:0] W2 = 8'sd2;
    localparam signed [WIDTH-1:0] W3 = 8'sd2;
    localparam signed [WIDTH-1:0] BIAS = -8'sd3;

    wire signed [2*WIDTH:0] sum_next;

    assign sum_next = (x1 * W1) +
                      (x2 * W2) +
                      (x3 * W3) +
                      BIAS;

    

always @(posedge clk) begin
    if (sum_next > 0)
        y <= sum_next;
    else
        y <= 0;
end


endmodule

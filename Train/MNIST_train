%% -------------------------------
% Step 9: Fixed-point reference check
%% -------------------------------
img = XTest(:,:,:,2000);          % one test digit
trueLabel =YTest(2000);
img_u8 = uint8(img * 255);     % FPGA-style input

kernel_fpga = double(weights_q(:,:,1,1));
bias_fpga   = double(biases_q(1));

ref = conv2(double(img_u8), kernel_fpga, 'valid');
ref = ref + bias_fpga;
ref = max(ref,0);              % ReLU

figure;
imagesc(ref); colormap gray;
title("Reference FPGA-style Conv Output (Kernel 1)");

fprintf("Fixed-point reference generated\n");


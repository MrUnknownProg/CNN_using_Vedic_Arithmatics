%% =========================================================
%  CNN TRAINING + KERNEL EXTRACTION FOR FPGA (ALL-IN-ONE)
%  Kernel: 3x3
%  Activation: ReLU
%  Pooling: MaxPool
%  FC + Softmax: MATLAB
%% =========================================================

clear; clc; close all;

%% -------------------------------
% Step 1: Load MNIST
%% -------------------------------
[XTrain, YTrain] = digitTrain4DArrayData;
[XTest,  YTest ] = digitTest4DArrayData;

YTrain = categorical(YTrain);
YTest  = categorical(YTest);

fprintf("MNIST loaded\n");

%% -------------------------------
% Step 2: Define CNN (FPGA-aligned)
%% -------------------------------
layers = [
    imageInputLayer([28 28 1], 'Normalization','none','Name','input')

    convolution2dLayer(3,8,'Padding',[0 0 0 0],'Name','conv1')
    reluLayer('Name','relu1')
    maxPooling2dLayer(2,'Stride',2,'Name','pool1')

    fullyConnectedLayer(10,'Name','fc')
    softmaxLayer('Name','softmax')
    classificationLayer('Name','output')
];

%% -------------------------------
% Step 3: Training options
%% -------------------------------
options = trainingOptions('adam', ...
    'MaxEpochs',25, ...
    'MiniBatchSize',64, ...
    'InitialLearnRate',0.01, ...
    'Shuffle','every-epoch', ...
    'Verbose',true, ...
    'Plots','none');

%% -------------------------------
% Step 4: Train network
%% -------------------------------
net = trainNetwork(XTrain, YTrain, layers, options);

%% -------------------------------
% Step 5: Verify accuracy
%% -------------------------------
YPred = classify(net, XTest);
accuracy = mean(YPred == YTest);

fprintf("Test Accuracy = %.2f %%\n", accuracy*100);

%% -------------------------------
% Step 6: Extract convolution weights
%% -------------------------------
convLayer = net.Layers(2);

weights = convLayer.Weights;   % 3x3x1x8
biases  = convLayer.Bias;      % 8x1

fprintf("Conv weights size: %s\n", mat2str(size(weights)));

%% -------------------------------
% Step 7: Quantization (FPGA-friendly)
%% -------------------------------
SCALE = 127;   % power-of-two friendly scale

weights_q = int8(weights * SCALE);
biases_q  = int16(biases * SCALE);

